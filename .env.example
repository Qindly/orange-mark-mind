# ============================================================================
# Orange Mark Mind - 环境变量配置模板
# 复制此文件为 .env 并修改敏感信息
# ============================================================================

# --------------------------------------------------------------------------
# PostgreSQL 配置
# --------------------------------------------------------------------------
POSTGRES_DB=orange_mark_mind
POSTGRES_USER=omm_user
POSTGRES_PASSWORD=omm_password_change_me

# 后端连接字符串（Docker 内部网络使用容器名）
# 格式: postgres://user:password@host:port/dbname?sslmode=disable
DATABASE_URL=postgres://omm_user:omm_password_change_me@postgres:5432/orange_mark_mind?sslmode=disable

# 本地开发连接字符串（使用 localhost）
DATABASE_URL_LOCAL=postgres://omm_user:omm_password_change_me@localhost:60101/orange_mark_mind?sslmode=disable

# --------------------------------------------------------------------------
# Redis 配置
# --------------------------------------------------------------------------
REDIS_PASSWORD=redis_password_change_me

# 后端连接字符串（Docker 内部网络）
REDIS_URL=redis://:redis_password_change_me@redis:6379/0

# 本地开发连接字符串
REDIS_URL_LOCAL=redis://:redis_password_change_me@localhost:60102/0

# --------------------------------------------------------------------------
# JWT 配置
# --------------------------------------------------------------------------
# JWT 签名密钥（生产环境请使用强随机字符串）
JWT_SECRET=your_jwt_secret_key_change_me_in_production

# Access Token 有效期（秒）
JWT_ACCESS_TOKEN_EXPIRE=900

# Refresh Token 有效期（秒）
JWT_REFRESH_TOKEN_EXPIRE=604800

# --------------------------------------------------------------------------
# 加密配置
# --------------------------------------------------------------------------
# AES-256-GCM 加密密钥（必须是 32 字节 = 256 位）
# 可使用命令生成: openssl rand -base64 32
ENCRYPTION_KEY=your_32_byte_encryption_key_here

# --------------------------------------------------------------------------
# 服务配置
# --------------------------------------------------------------------------
# 后端服务端口
PORT=60100

# Gin 运行模式: debug / release
GIN_MODE=debug

# --------------------------------------------------------------------------
# 前端配置
# --------------------------------------------------------------------------
# 前端开发服务器端口
VITE_PORT=60103

# API 基础地址
VITE_API_BASE_URL=http://localhost:60100/api/v1
